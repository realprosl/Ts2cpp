{
  "name": "estatic-ts-cpp",
  "version": "0.25.0",
  "private": true,
  "type": "module",
  "description": "Transpilador modular de un subconjunto estático de TypeScript a C++20",
  "bin": {
    "estatic": "src/cli.ts",
    "estatic-lexer": "src/tools/lexer.ts",
    "estatic-parser": "src/tools/parser.ts",
    "estatic-semantic": "src/tools/semantic.ts",
    "estatic-codegen": "src/tools/codegen.ts",
    "estatic-format": "src/tools/format.ts",
    "estatic-doc": "src/tools/doc.ts"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/cli.ts",
    "init": "node --experimental-strip-types src/cli.ts init",
    "test": "node --experimental-strip-types --test test/runner.ts"
  },
  "engines": { "node": ">=22.6" }
}
