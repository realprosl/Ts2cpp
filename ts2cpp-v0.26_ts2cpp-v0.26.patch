+  using greeting: string = &quot;hello&quot;;
+  print(greeting);
+
+  // Caso 2: `using` con tipo Optional&lt;T&gt; — RAII ya garantiza cleanup.
+  using maybe: Optional&lt;number&gt; = optionalSome(42);
+  print(numberToString(maybe ?? -1));
+
+  // Caso 3: `using` con tipo vector.
